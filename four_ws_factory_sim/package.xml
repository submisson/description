<?xml version="1.0"?>
<package format="3">
  <name>four_ws_factory_sim</name><version>1.0.0</version>
  <description>Four-wheel-steer side loader, five LiDARs and EPAL pallet handling in Gazebo Classic.</description>
  <maintainer email="maintainer@example.invalid">4WS simulation maintainer</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend><buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>gazebo_dev</build_depend>
  <depend>gazebo_ros</depend><depend>rclcpp</depend><depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend><depend>tf2_ros</depend><depend>nav_msgs</depend>
  <exec_depend>gazebo_plugins</exec_depend><exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>launch</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>four_ws_vehicle_description</exec_depend><exec_depend>four_ws_sensor_kit_description</exec_depend>
  <exec_depend>four_ws_sensor_kit_launch</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models" plugin_path="${prefix}/../../lib"/>
  </export>
</package>
