#!/usr/bin/env python3
"""Independent live acceptance check for the default factory and demonstration."""
import math
import sys
import time
import rclpy
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, qos_profile_sensor_data
from gazebo_msgs.srv import GetEntityState
from sensor_msgs.msg import PointCloud2
from std_msgs.msg import String


class Acceptance(Node):
    def __init__(self):
        super().__init__('check_pick')
        self.declare_parameter('pallet','pallet_A')
        self.declare_parameter('wall_timeout',1200.)
        self.client=self.create_client(GetEntityState,'/gazebo/get_entity_state')
        self.create_subscription(String,'/forklift/demo_status',self.on_status,
            QoSProfile(depth=1,durability=DurabilityPolicy.TRANSIENT_LOCAL))
        self.frames=[set() for _ in range(5)]
        for i in range(5):
            self.create_subscription(PointCloud2,f'/sensing/lidar/l{i+1}/pointcloud_before_sync',
                lambda msg,k=i:self.on_scan(k,msg),qos_profile_sensor_data)
        self.future=None
        self.origin=None
        self.max_lift=0.
        self.air_travel=0.
        self.phase=''
        self.finished=None
        self.started_wall=time.monotonic()
        self.began_in_air=False
        self.create_timer(.15,self.sample)

    def on_status(self,msg):
        self.phase=msg.data
        if self.phase.startswith('FAILED'):
            self.finish(False,self.phase)

    def on_scan(self,i,msg):
        if len(self.frames[i])>=2:
            return
        names={f.name for f in msg.fields}
        if (msg.header.frame_id==f'mid360_l{i+1}' and msg.width*msg.height>0 and
                {'x','y','z'}<=names and len(msg.data)>=msg.row_step*msg.height):
            self.frames[i].add((msg.header.stamp.sec,msg.header.stamp.nanosec))

    def finish(self,ok,why):
        if self.finished is not None:
            return
        self.finished=ok
        log=self.get_logger().info if ok else self.get_logger().error
        log(('PASS ' if ok else 'FAIL ')+why)

    def sample(self):
        if self.future is not None:
            if not self.future.done():
                return
            try:
                response=self.future.result()
            except Exception as exc:
                return self.finish(False,'Gazebo state service: '+str(exc))
            self.future=None
            if response.success:
                p=response.state.pose.position
                if self.origin is None:
                    self.origin=(p.x,p.y,p.z)
                    self.began_in_air=p.z>.03
                ox,oy,oz=self.origin
                dz=p.z-oz
                dxy=math.hypot(p.x-ox,p.y-oy)
                self.max_lift=max(self.max_lift,dz)
                if dz>.10:
                    self.air_travel=max(self.air_travel,dxy)
                if self.phase=='DONE':
                    scans=sum(len(times)>=2 for times in self.frames)
                    ok=(not self.began_in_air and self.max_lift>.12 and self.air_travel>.42 and
                        dxy>.42 and abs(dz)<.025 and scans==5)
                    self.finish(ok,f'lidars={scans}/5, lift={self.max_lift:.3f} m, '
                        f'air_travel={self.air_travel:.3f} m, final_travel={dxy:.3f} m, '
                        f'final_dz={dz:.3f} m')
                    return
        if self.client.service_is_ready():
            req=GetEntityState.Request()
            req.name=self.get_parameter('pallet').value
            req.reference_frame='world'
            self.future=self.client.call_async(req)


def main():
    rclpy.init()
    node=Acceptance()
    try:
        while rclpy.ok() and node.finished is None:
            rclpy.spin_once(node,timeout_sec=.3)
            if time.monotonic()-node.started_wall>node.get_parameter('wall_timeout').value:
                node.finish(False,'wall-clock timeout waiting for live simulation')
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()
    return 0 if node.finished else 1


if __name__=='__main__':
    sys.exit(main())
